{
  "name": "onecard-lab",
  "version": "0.1.0",
  "private": true,
  "description": "OneCard virtual lab: a self-contained simulation of the OneCard school card system (virtual cards, canteen readers, water machines, top-up kiosk, MQTT broker and platform) for testing and demos before real hardware.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --disable-warning=ExperimentalWarning --test \"test/unit/**/*.test.js\"",
    "test:scenarios": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/scenarios/**/*.test.js\""
  },
  "dependencies": {
    "aedes": "1.2.0",
    "mqtt": "5.16.0"
  }
}
